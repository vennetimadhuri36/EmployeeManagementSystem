
@model List<EmployeeManagementMVC1.Models.Employee>

<h2>Employee List</h2>
<a asp-action="Create" class="btn btn-primary mb-3">Add Employee</a>
<form method="get" asp-action="Search">
    <div class="row mb-3">
        <div class="col-md-4">
            <input type="text"
                   name="name"
                   class="form-control"
                   placeholder="Search Employee" />
        </div>

        <div class="col-md-2">
            <button type="submit"
                    class="btn btn-primary">
                Search
            </button>
        </div>
    </div>
</form>
<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Department</th>
            <th>Salary</th>
            <th>Email</th>
            <th></th>
            
        </tr>
    </thead>

    <tbody>
        @foreach (var emp in Model)
        {
            <tr>
                <td>@emp.Id</td>
                <td>@emp.Name</td>
                <td>@emp.Department</td>
                <td>@emp.Salary</td>
                <td>@emp.Email</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@emp.Id"
                       class="btn btn-warning btn-sm">
                        Edit
                    </a>
                
                <a asp-action="Delete"
                   asp-route-id="@emp.Id"
                   class="btn btn-danger btn-sm"
                   onclick="return confirm('Are you sure you want to delete this employee?');">
                    Delete
                </a>
                </td>
            </tr>
        }
    </tbody>
</table>